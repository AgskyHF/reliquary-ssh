# ---- ReliquarySSH environment ----
# Copy to .env and fill in. NEVER commit the real .env.

# Backend sync server (used by /server)
PORT=8790
DATABASE_PATH=./data/reliquary.db

# JWT signing secret for the backend
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 (PKCE) — desktop client id
GOOGLE_CLIENT_ID=

# Google OAuth 2.0 — server-side client id for the /auth/google endpoint
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8790/auth/google/callback

# Server log — empty means "next to the database file"
LOG_PATH=
LOG_LEVEL=info
