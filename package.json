{
  "name": "reliquary-ssh",
  "version": "0.1.0",
  "description": "SSH and SFTP terminal client — tabs, a key store and a portable export",
  "main": "./out/main/index.js",
  "author": "AgskyHF",
  "license": "MIT",
  "type": "module",
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:mac": "npm run build && npm run prepare:native && electron-builder --mac --publish never",
    "package": "npm run build && npm run prepare:native && electron-builder --publish never",
    "prepare:native": "node scripts/prepare-native.mjs",
    "icon": "node_modules/electron/dist/Electron.app/Contents/MacOS/Electron scripts/make-icon.mjs"
  },
  "dependencies": {
    "@types/ssh2-sftp-client": "^9.0.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "ws": "^8.22.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "ssh2@1.17.0": true,
    "electron-winstaller@5.4.0": true,
    "cpu-features@0.0.10": true,
    "fsevents@2.3.3": true
  }
}
